# FinvQuant 部署环境变量示例（复制为 .env 后按需修改）
#   cp deploy/.env.example deploy/.env
#   docker compose --env-file deploy/.env up -d

# PostgreSQL 18
FINV_PG_USER=finvquant
FINV_PG_PASSWORD=finvquant
FINV_PG_DATABASE=finvquant
# 宿主访问 PG 端口（默认 5433，避免与本地 5432 冲突）
FINV_PG_EXPOSE_PORT=5433

# Redis 8
FINV_REDIS_PASSWORD=
# 宿主访问 Redis 端口（默认 6380）
FINV_REDIS_EXPOSE_PORT=6380

# 镜像 tag（latest / 版本号）
FINV_IMAGE_TAG=latest

# 时区
TZ=Asia/Shanghai
