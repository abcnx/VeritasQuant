# ============================================================
# FinvQuant 仓库根目录忽略规则（Go 服务端为主）
# VeritasQuant/ 子项目有独立的 .gitignore，此处为根目录兜底
# ============================================================

# ---- Go ----
/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.out
coverage.html
vendor/

# ---- 通用 ----
.DS_Store
*.log
*.tmp
*.swp

# ---- 编辑器 ----
.idea/
.vscode/
*.code-workspace

# ---- Python（VeritasQuant 子项目兜底）----
__pycache__/
.venv/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
build/
dist/
*.egg-info/

# ---- Node（Web 前端兜底）----
node_modules/
Web/dist/
# Go embed 前端产物（构建时生成，不提交）
internal/webui/dist/

# ---- 部署 ----
Deploy/.env
Docker/.env.deploy
# PG 数据目录（宿主机映射，本机生成的 pgdata 不提交）
Deploy/pgdata/
