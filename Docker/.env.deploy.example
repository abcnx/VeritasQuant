# VeritasQuant 服务端部署环境变量（复制为 .env.deploy 后按需修改）。
#
# 用法：复制本文件为 Docker/.env.deploy，填入实际密码后执行
#   python3 scripts/DeployServer.py start
#
# ⚠️ 安全提示：
# - VQ_POSTGRES_PASSWORD 为必填，未设置时 PostgreSQL 容器拒绝启动；
# - 本文件包含明文密码，仅限本地开发机；不要提交到 Git（已在 .gitignore 建议）；
# - 模拟盘/仿真环境默认禁用实盘；任何实盘启用必须先走 Change 并满足 TechSpec 13 gate。

# 运行环境：PAPER（模拟盘）或 SIMULATION（券商仿真）。禁止 LIVE。
VQ_ENVIRONMENT=PAPER

# 服务端镜像：默认拉取 GitHub Packages（ghcr.io）镜像。
# VQ_IMAGE_TAG 可指定版本（如 0.1.1）或 latest。
VQ_IMAGE_OWNER=acanx
VQ_IMAGE_TAG=latest

# 宿主映射端口：API 服务对 Windows 主机暴露的端口（默认 18000，12000 以后避开常用端口）。
VQ_API_PORT=18000

# 时区（日志与调度展示用，内部时间仍为 UTC）。
TZ=Asia/Shanghai

# PostgreSQL 密码（必填，至少 12 位强密码）。
VQ_POSTGRES_PASSWORD=change-me-to-a-strong-password

# 数据导入目录（宿主绝对路径或相对 compose 文件的路径，挂载到容器 /opt/veritasquant/data）。
VQ_DATA_DIR=./data

# PostgreSQL 数据目录（宿主绝对路径，默认映射到 D:\Dev\Docker\HostFileSystem\VeritasQuant\PostgreSQL）。
VQ_POSTGRES_DATA_DIR=D:/Dev/Docker/HostFileSystem/VeritasQuant/PostgreSQL
